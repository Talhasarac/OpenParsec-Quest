# Gradle / IDE
.gradle/
build/
.cxx/
.idea/
*.iml
local.properties

# Native build outputs
app/.cxx/
app/build/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.bak
*.log

# Credentials and local-only configuration. NEVER commit.
.env
.env.*
*.jks
keystore.properties
# Keystores generally don't belong in git, EXCEPT for our shared
# openparsec-release.keystore which intentionally lives in the repo so
# every CI build signs releases with the same identity (otherwise
# Android refuses to update between APKs signed with different certs).
*.keystore
!openparsec-release.keystore
